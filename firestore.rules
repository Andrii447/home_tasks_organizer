rules_version = '2';

// Правила доступу Cloud Firestore для ДімПлан (лабораторна №6).
//
// Структура:
//   users/{uid}                          — профіль користувача
//   households/{householdId}             — домогосподарство
//   households/{householdId}/tasks/{id}  — завдання домогосподарства
//   invites/{code}                       — код приєднання → id дому
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMe(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function household(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function isMember(householdId) {
      return signedIn() && request.auth.uid in household(householdId).memberIds;
    }

    // Змінено лише вказані поля документа.
    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ---------------------------------------------------------------- users
    // Профіль читає й змінює лише його власник.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;
    }

    // ----------------------------------------------------------- households
    match /households/{householdId} {
      // Дані дому бачать лише його учасники.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      // Створити дім можна лише власником і єдиним учасником.
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40;

      allow update: if signedIn() && (
        // Власник змінює назву та склад учасників, але не себе як власника.
        (request.auth.uid == resource.data.ownerId
          && onlyChanged(['name', 'memberIds', 'memberNames'])
          && request.resource.data.ownerId == resource.data.ownerId
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40)
        ||
        // Приєднання: користувач додає до учасників лише себе.
        (!(request.auth.uid in resource.data.memberIds)
          && onlyChanged(['memberIds', 'memberNames'])
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberNames.diff(resource.data.memberNames)
               .affectedKeys().hasOnly([request.auth.uid]))
        ||
        // Учасник оновлює лише своє ім'я у списку учасників.
        (request.auth.uid in resource.data.memberIds
          && onlyChanged(['memberNames'])
          && request.resource.data.memberNames.diff(resource.data.memberNames)
               .affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;

      // ----------------------------------------------------------- tasks
      // Завдання читають і змінюють усі учасники дому (FR-09).
      match /tasks/{taskId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId)
          && request.resource.data.createdBy == request.auth.uid
          && validTask();
        allow update: if isMember(householdId)
          && request.resource.data.createdBy == resource.data.createdBy
          && validTask();

        function validTask() {
          let t = request.resource.data;
          return t.title is string && t.title.size() > 0 && t.title.size() <= 80
            && t.description is string && t.description.size() <= 500
            && t.status in ['planned', 'inProgress', 'completed'];
        }
      }
    }

    // -------------------------------------------------------------- invites
    // Код приєднання — «ключ» до дому: його можна прочитати, лише знаючи
    // сам код (get), а переглянути список усіх кодів (list) не можна.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;
      // Дім і його код створюються одним пакетним записом, тому власника
      // перевіряємо за станом після запису (getAfter).
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId))
             .data.ownerId == request.auth.uid;
      allow delete: if signedIn()
        && household(resource.data.householdId).ownerId == request.auth.uid;
    }
  }
}
